# 本模板由根目录 docker-compose.yml 读取的两个 .env 文件共同组成。
# 真实密钥只写入 Lexoid/.env 或 pipeline/texopt/.env，不要提交到 Git。

# 根 Compose 的生产镜像和基础依赖镜像。
BASE_RUNTIME_IMAGE=pdftotex-runtime:local

# 队列 worker 的默认运行参数；单批次启动时可用 docker compose run -e 覆盖。
RECOGNITION_OCR=none
VISION_CONCURRENCY=2
RECONCILE_CONCURRENCY=2
RENDER_DPI=240
RETRY_DPI=480
PIPELINE_STAGE_TIMEOUT_SECONDS=43200
PIPELINE_PUBLISH_ROOT=/data/optimized
TEXOPT_SEMANTIC_NAMING=deferred
TEXOPT_NAME_CACHE=/data/.cache/semantic-names.sqlite3

# 视觉识别、局部复核和 TeX 语法修复模型。
LEXOID_MODEL=gpt-5.6-sol
SOL_VISION_REASONING_EFFORT=none
VISION_FALLBACK_MODEL=gpt-6-astra
RECONCILE_MODEL=gpt-6-astra
TEXOPT_REPAIR_MODEL=gpt-5.6-sol
TEXOPT_MODEL=deepseek-v4-flash
OPTIMIZER_EXTRA_ARGS=--syntax-repair-cache /data/state/texopt-syntax-repairs.json --llm-repair-on-failure --compile-check
OPTIMIZER_TIMEOUT_SECONDS=3600

# API 配置示例。请在本地文件中填写，不要写入 README、队列或镜像。
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://<your-provider>/compatible-mode/v1
# ANTHROPIC_API_KEY=

# 仅失败任务隔离修复脚本使用。
CODEX_MODEL=gpt-5.6-sol
