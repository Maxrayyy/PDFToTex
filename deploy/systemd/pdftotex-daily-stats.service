[Unit]
Description=PDFToTex daily statistics update
ConditionPathExists=@PDFTOTEX_ROOT@/data/monitoring/daily/config.json

[Service]
Type=oneshot
User=pdftotex
Group=pdftotex
WorkingDirectory=@PDFTOTEX_ROOT@/PDFToTex
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 @PDFTOTEX_ROOT@/PDFToTex/pipeline/texopt/monitoring/daily_stats.py once --config @PDFTOTEX_ROOT@/data/monitoring/daily/config.json
UMask=0027
